{
  "name": "@kevinbrowncodes/flow",
  "version": "0.2.0",
  "description": "Google Flow–style editor UI for local video/image generation backends. One adapter seam; model repos implement the Flow Gateway Protocol.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinbrowncodes/flow.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist/lib",
    "protocol/PROTOCOL.md"
  ],
  "main": "./dist/lib/flow.js",
  "module": "./dist/lib/flow.js",
  "exports": {
    ".": "./dist/lib/flow.js",
    "./style.css": "./dist/lib/flow.css"
  },
  "sideEffects": [
    "**/*.css",
    "./src/lib.js",
    "./src/styles/index.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mock": "VITE_FLOW_ADAPTER=mock VITE_FLOW_ROUTER=browser vite build --base=/",
    "build:lib": "vite build -c vite.lib.config.js",
    "build:all": "npm run build && npm run build:lib",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "node --test tests/unit/*.test.js",
    "conform": "playwright test",
    "baseline": "playwright test --update-snapshots",
    "prepack": "npm run build:lib",
    "conform:gateway": "playwright test -c playwright.gateway.config.js"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "material-symbols": "^0.46.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  }
}
